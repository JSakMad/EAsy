DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easy_a_finder
DATABASE_SSL=false
PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_API_KEY=replace-with-a-long-random-value
NEXT_PUBLIC_API_URL=http://localhost:4000
# OAuth runs in Next.js. Also put these and DATABASE_URL / DATABASE_SSL in
# apps/web/.env.local for local authentication; Next does not load root .env.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server only. Put the key in .env for API overviews and apps/web/.env.local
# (or the web host environment) for syllabus AI. Never use NEXT_PUBLIC_*.
# Keep the Groq account on its Free plan; paid billing is controlled by Groq.
GROQ_API_KEY=
