DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easy_a_finder
DATABASE_SSL=false
PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_API_KEY=replace-with-a-long-random-value
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server only. Put the real key in .env, never here or in NEXT_PUBLIC_*.
# Keep the Groq account on its Free plan; paid billing is controlled by Groq.
GROQ_API_KEY=
# Set both to true when choosing to enable the importer.
RMP_INGESTION_ENABLED=false
RMP_TERMS_REVIEWED=false
RMP_REQUEST_DELAY_MS=5000
RMP_MAX_REQUESTS_PER_RUN=50
RMP_MAX_REQUESTS_PER_DAY=200
RMP_MAX_PROFESSORS_PER_RUN=5
RMP_SCHOOL_LEGACY_ID=1247
RMP_SCHOOL_RELAY_ID=U2Nob29sLTEyNDc=
